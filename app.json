{
  "expo": {
    "name": "SIDB",
    "slug": "sidb",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/img/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/img/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sidb.distribuidora",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/img/logo.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Esta app necesita tu ubicación siempre para registrar la posición del cobrador en tiempo real.",
          "locationWhenInUsePermission": "Esta app necesita la ubicación para registrar visitas de cobro.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Esta app necesita la cámara para tomar fotos de visitas."
        }
      ]
    ],
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://panel.distribuidorabriancescomenjivar.com/api"
    }
  }
}
